@{ ViewData["Title"] = "Privacy"; }
<div class="workspace-heading"><h1>Privacy</h1></div>
<section class="working-surface details-form">
    <h2>Local document processing</h2>
    <p>PDFs are uploaded to this local Harbor server for redaction. Temporary originals are deleted; processed copies remain on this machine and are uploaded to the team’s AWS S3 bucket.</p>
    <p class="mb-0">Review redacted files before sharing. Scanned pages may still contain personal details when uploaded. Use fictional test documents.</p>
</section>
